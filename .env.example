# ==============================================================
# 🔐 SECRETS & CONFIGURATION
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ==============================================================

# --- AI Backend Strategy ---
# Set to 'true' to use Vertex AI (Mode B - Production)
# Set to 'false' to use Gemini API (Mode A - Development via AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=false

# Mode A Settings (Gemini API via AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Mode B Settings (Vertex AI)
VERTEX_PROJECT_ID=your_gcp_project_id
VERTEX_LOCATION=us-central1

# --- Blog / Publishing Backend ---
# Set to 'docs' (Google Docs - draft only) or 'blogger' (Blogger - draft only)
BLOG_BACKEND=docs

# Google Docs Settings
# The ID of the folder where blog drafts should be created
GOOGLE_DOCS_OUTPUT_FOLDER_ID=your_docs_folder_id

# Blogger Settings
# The ID of your Blogger blog
BLOGGER_BLOG_ID=your_blogger_blog_id

# --- Application Settings ---
# Comma-separated list of domains/emails to skip in morning feed/journalist
EMAIL_SKIP_SENDERS=*@substack.com,*@medium.com,*@mailchimp.com,*@sendgrid.net,*@linkedin.com,*@quora.com,*@devops.com

# Path to local SQLite DB (if running locally)
LOCAL_DB_PATH=data/agent_state.db

# --- Partner Calendar Filtering ---
# Google Calendar ID of your partner's calendar (usually their Gmail address)
# Events from this calendar whose titles contain any PARTNER_EXCLUDE_CATEGORIES keyword are hidden.
PARTNER_CALENDAR_ID=partners_gmail@gmail.com

# Comma-separated list of keywords to filter out from the partner's calendar
# (case-insensitive match against event title)
PARTNER_EXCLUDE_CATEGORIES=fitness,wellness,gym,yoga,pilates,crossfit,class,training,workout,exercise,heated,strength,cycling,spin,barre,dance,meditation,stretch,bootcamp,hiit,run,walk
